{
  "name": "henrys-reading-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Henry's Reading World — first-round experience prototype",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local-private",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pool": "node scripts/build-candidate-pool.ts",
    "idmap:v2": "node scripts/build-id-map-v2.ts",
    "dossiers:v2": "node scripts/build-book-dossiers.ts",
    "verify:ids": "node scripts/verify-id-stability.ts",
    "snapshot:local": "node scripts/build-local-snapshot.ts",
    "validate:data:local": "node scripts/validate-snapshot.ts .private/local-snapshot.json",
    "validate:data": "node scripts/validate-snapshot.ts src/data/public-snapshot.json",
    "smoke:local": "vitest run tests/local-snapshot.smoke.test.tsx",
    "check:local": "npm run typecheck && npm run lint && npm run test && npm run validate:data:local",
    "build": "npm run validate:data && npm run typecheck && vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:data && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:publication": "playwright test --config playwright.publication.config.ts",
    "test:tags": "playwright test --config playwright.tag-studio.config.ts",
    "test:public": "playwright test --config playwright.empty.config.ts",
    "capture:review": "playwright test --config playwright.capture.config.ts",
    "capture:v2e": "playwright test --config playwright.capture-v2e.config.ts",
    "capture:v2e4": "playwright test --config playwright.capture-v2e4.config.ts",
    "capture:v3-batch4": "playwright test --config playwright.capture-v3-batch4.config.ts",
    "capture:v3-batch5": "playwright test --config playwright.capture-v3-batch5.config.ts",
    "capture:release-a": "playwright test --config playwright.capture-release-a.config.ts && playwright test --config playwright.capture-publication.config.ts",
    "publication:init": "node scripts/publication-init.ts",
    "publication:review": "vite --mode review-private",
    "tags:studio": "vite --mode tag-studio-private",
    "publication:preview": "node scripts/publication-preview.ts",
    "publication:audit:v3": "node scripts/publication-v3-audit.ts",
    "publication:export": "node scripts/publication-export.ts",
    "publication:verify": "node scripts/public-release-verify.ts",
    "isolation:public": "node scripts/check-public-isolation.ts",
    "covers:fetch": "node scripts/fetch-covers.ts",
    "embeddings:prepare": "node scripts/embedding-prepare.ts",
    "embeddings:baseline": "node scripts/embedding-baseline.ts",
    "embeddings:evaluate": "node scripts/embedding-evaluate.ts",
    "embeddings:generate": "node scripts/embedding-generate.ts",
    "map:layout": "node scripts/build-map-layout.ts --scope=local",
    "map:layout:public": "node scripts/build-map-layout.ts --scope=public",
    "embeddings:compare": "node scripts/embedding-compare.ts",
    "embeddings:neighbours": "node scripts/embedding-neighbours.ts",
    "tags:sample": "node scripts/tag-discovery-sample.ts",
    "tags:clusters": "node scripts/tag-discovery-clusters.ts",
    "tags:seeds": "node scripts/tag-candidate-seeds.ts",
    "tags:audit": "node scripts/tag-candidate-audit.ts",
    "tags:promote": "node scripts/tag-vocabulary-promote.ts",
    "tags:trial:generate": "node scripts/tag-trial-generate.ts",
    "tags:trial:review": "node scripts/tag-trial-review.ts",
    "tags:trial:audit": "node scripts/tag-trial-audit.ts",
    "tags:full:generate": "node scripts/tag-full-generate.ts",
    "tags:full:reranker:evaluate": "node scripts/tag-reranker-evaluate.ts",
    "tags:full:rerank": "node scripts/tag-full-rerank.ts",
    "tags:full:review": "node scripts/tag-full-review.ts",
    "tags:full:override": "node scripts/tag-full-override.ts",
    "tags:full:audit": "node scripts/tag-full-audit.ts",
    "tags:review-queue": "node scripts/tag-review-queue.ts",
    "tags:review-import": "node scripts/tag-review-import.ts",
    "tags:review-apply": "node scripts/tag-review-apply.ts",
    "tags:migrate": "node scripts/tag-merge.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "4.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "umap-js": "^1.4.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
