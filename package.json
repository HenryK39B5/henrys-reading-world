{
  "name": "henrys-reading-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Henry's Reading World — first-round experience prototype",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local-private",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pool": "node scripts/build-candidate-pool.ts",
    "idmap:v2": "node scripts/build-id-map-v2.ts",
    "dossiers:v2": "node scripts/build-book-dossiers.ts",
    "verify:ids": "node scripts/verify-id-stability.ts",
    "snapshot:local": "node scripts/build-local-snapshot.ts",
    "validate:data:local": "node scripts/validate-snapshot.ts .private/local-snapshot.json",
    "validate:data": "node scripts/validate-snapshot.ts src/data/public-snapshot.json",
    "smoke:local": "vitest run tests/local-snapshot.smoke.test.tsx",
    "check:local": "npm run typecheck && npm run lint && npm run test && npm run validate:data:local",
    "build": "npm run validate:data && npm run typecheck && vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:data && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:public": "playwright test --config playwright.empty.config.ts",
    "capture:review": "playwright test --config playwright.capture.config.ts",
    "covers:fetch": "node scripts/fetch-covers.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
